# 64 hex characters (32 bytes). Encrypts patient/personal fields in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: this key is the only way to read the encrypted data back. Keep a copy
# somewhere safe, and if you move the database to another PC, move this exact key
# with it - a different key makes every encrypted record unreadable.
DATA_ENC_KEY=

PORT=4001
CORS_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinix
DB_USER=root
DB_PASSWORD=

# Starting the backend also starts MySQL if it is not running, so nobody has to
# open the XAMPP Control Panel. Set to false if MySQL runs as a Windows service,
# or if the database lives on another computer.
MYSQL_AUTOSTART=true

# Only needed when XAMPP is somewhere other than C:\xampp. Point this at the
# folder that contains mysqld.exe.
# MYSQL_BIN=C:\xampp\mysql\bin

# ── AI medicine suggestions (optional) ───────────────────────────────────────
# Enables the "Suggest medicines" button on a consultation. Leave it blank and
# the feature simply reports itself off; nothing else in the system changes.
#
# PRIVACY: with this set, the complaint and assessment text are sent to
# Anthropic's API to get suggestions back. The patient's name, student ID,
# birthdate and contact details are never included. Suggestions are advisory —
# the nurse decides, and nothing is dispensed automatically.
#
# Get a key at https://console.anthropic.com — it is billed per use.
ANTHROPIC_API_KEY=
