# 64 hex characters (32 bytes). Encrypts patient/personal fields in the database.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: this key is the only way to read the encrypted data back. Keep a copy
# somewhere safe, and if you move the database to another PC, move this exact key
# with it - a different key makes every encrypted record unreadable.
DATA_ENC_KEY=

PORT=4001
CORS_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinix
DB_USER=root
DB_PASSWORD=

# Starting the backend also starts MySQL if it is not running, so nobody has to
# open the XAMPP Control Panel. Set to false if MySQL runs as a Windows service,
# or if the database lives on another computer.
MYSQL_AUTOSTART=true

# Only needed when XAMPP is somewhere other than C:\xampp. Point this at the
# folder that contains mysqld.exe.
# MYSQL_BIN=C:\xampp\mysql\bin

# ── AI medicine suggestions (optional) ───────────────────────────────────────
# Suggests medicines from the complaint and assessment. The model runs LOCALLY
# via Ollama on this PC, so no patient information ever leaves the clinic and
# there is nothing to pay per request.
#
# Setup:
#   1. Install Ollama       https://ollama.com/download   (Windows installer)
#   2. Pull the model       ollama pull llama3.2:3b
#   3. Restart Clinix. The panel turns itself on once both are in place.
#
# HARDWARE: llama3.2:3b needs about 2 GB of free RAM and runs on an 8 GB PC.
# A 7B model such as mistral gives better answers but needs roughly 5 GB free —
# on an 8 GB PC it swaps to disk and effectively never answers (measured, not
# guessed). With 16 GB, set OLLAMA_MODEL=mistral.
#
# BEFORE A NURSE USES THIS, TEST THE MODEL. A 1.2B model was measured against
# four presentations and, given a patient vomiting blood with rebound
# tenderness, suggested four medicines and advised no referral. Small models
# produce confident, well-formatted, wrong answers. 3B has not been measured
# against those cases. Run your own real presentations through it — including
# one that needs referral rather than medicine — and set AI_SUGGESTIONS=false
# if it gets that wrong. The nurse formulary works without any of this.
#
# Even though it runs locally, only the complaint, assessment, purpose, age and
# sex are passed to the model. Name, student ID, birthdate and contact details
# are never included.

# Turn the feature off entirely without uninstalling anything.
AI_SUGGESTIONS=true

# Which pulled model to use. Must match a name from `ollama list`.
OLLAMA_MODEL=llama3.2:3b

# Only needed if Ollama runs somewhere other than this PC's default port.
# OLLAMA_URL=http://127.0.0.1:11434

# How long to wait for an answer, in milliseconds. Local inference is slow;
# raise this on a modest PC rather than lowering it.
# OLLAMA_TIMEOUT_MS=180000
